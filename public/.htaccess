# =======================================================
# Ecoleta — Apache config for Next.js static export
# =======================================================

# --- 1. HTTPS — single 301, no chain ------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS first
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Serve /path/index.html internally for /path (no extra redirect)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/index.html [L]
</IfModule>

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# --- 2. Compression -----------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS \
    text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml font/woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE \
    text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml font/woff2
</IfModule>

# --- 3. Cache headers ---------------------------------
<IfModule mod_headers.c>
  # Next.js hashed assets (_next/static/) — permanent cache
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images — 6 months
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>

  # HTML — always revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|webp|avif|gif|ico|svg)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
</IfModule>
