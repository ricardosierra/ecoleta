# ─────────────────────────────────────────────────────────────────────────────
# Configuração pública (acessível no client) — placeholders para troca rápida
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ecolevaeco.com/

# Contato exibido no site
NEXT_PUBLIC_CONTACT_EMAIL=contato@ecolevaeco.com
NEXT_PUBLIC_WHATSAPP_NUMBER=55XXXXXXXXXXX

# Redes sociais
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/XXXXXXXX
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/XXXXXXXX

# Dados institucionais (rodapé)
NEXT_PUBLIC_CNPJ=00.000.000/0000-00
NEXT_PUBLIC_ADDRESS=Endereço a definir

# ─────────────────────────────────────────────────────────────────────────────
# Envio do formulário (server-side, NÃO expor no client)
# ─────────────────────────────────────────────────────────────────────────────

# Destinatário das mensagens do formulário
CONTACT_TO_EMAIL=contato@ecolevaeco.com
CONTACT_FROM_EMAIL=noreply@ecolevaeco.com
CONTACT_FROM_NAME=Site Ecoleta

# ─── Opção 1: Resend (recomendado) ───
# Cadastre o domínio em https://resend.com/domains, crie uma API key e cole aqui
RESEND_API_KEY=

# ─── Opção 2: SMTP autenticado (usar em vez do Resend) ───
# Para usar SMTP, instalar nodemailer:
#   npm install nodemailer @types/nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# Banco de Dados MySQL (Hostinger)
# ─────────────────────────────────────────────────────────────────────────────

# Usuário DA APLICAÇÃO. Precisa apenas de SELECT, INSERT, UPDATE e DELETE nas
# tabelas do dashboard — nada de CREATE, ALTER ou DROP. É este par que o deploy
# grava em public/api/env.php e que o PHP servido pela web usa.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=SUA_SENHA_AQUI

# Usuário DE MIGRATION, com permissão de DDL. Usado só por `php db/migrate.php`,
# por SSH/CLI, e NUNCA gravado em public/api/env.php — se ele vazar pela web, um
# invasor ganha DROP TABLE. Sem estes valores o runner cai em DB_USER/DB_PASS e
# avisa. Ver docs/deploy.md para o GRANT de cada um.
DB_DDL_USER=
DB_DDL_PASS=
# Porta, quando não for 3306 — lida só pelo runner (útil para túnel SSH).
# O PHP servido pela web usa sempre a porta padrão do DB_HOST.
DB_PORT=

# Dashboard — segredos SEM o prefixo NEXT_PUBLIC_. Tudo que leva esse prefixo é
# embutido no bundle do navegador; estas variáveis só chegam ao PHP, via
# public/api/env.php gerado pelo deploy.

# Login do usuário root criado pela instalação única (padrão: admin)
DASHBOARD_ROOT_LOGIN=admin

# Token de api/install.php — sem ele o endpoint responde 404 e nenhum root é criado.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
# Depois de criar o root, apague o valor daqui e refaça o deploy.
DASHBOARD_INSTALL_TOKEN=

# URL de publicação do relatório Power BI (view?r=...). Continua NEXT_PUBLIC_
# porque é embutida no site — não é segredo.
NEXT_PUBLIC_POWERBI_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Asaas (cobranças) — segredos, sem prefixo NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────────────────────────
# A chave começa com "$" e traz outro "$" no meio. Mantenha SEMPRE entre aspas
# simples: o deploy dá `source` neste arquivo e sem elas o shell come a chave.
#   ASAAS_API_KEY='$aact_prod_...'
ASAAS_API_KEY=

# Segredo do cron de cobranças. Vai no header X-Cron-Secret (preferido) ou em
# ?secret= na URL. SEM ele api/cron/billing.php recusa rodar — não há mais valor
# padrão embutido no código.
# Gere com: php -r "echo bin2hex(random_bytes(32));"
CRON_SECRET=

# Token do webhook do Asaas (Configurações > Integrações > Webhooks, campo
# "Token de autenticação"). O Asaas o repete no header `asaas-access-token` de
# cada evento. Sem ele api/webhooks/asaas.php recusa TODO evento: é o que
# impede alguém de dar baixa em fatura mandando um POST de três linhas.
# Gere com: php -r "echo bin2hex(random_bytes(24));"
ASAAS_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Cloud API (Meta) — "WhatsApp do robô" da Ordem de Serviço
# ─────────────────────────────────────────────────────────────────────────────
# Credenciais do app da Meta. Sem elas o botão do robô responde 503 e sobra o
# "Meu WhatsApp", que abre o wa.me e não depende de nada disto.
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Template aprovado para encaminhar a OS. Em branco, o robô manda texto livre —
# que a Meta só entrega se o cliente tiver escrito para o número nas últimas 24
# horas. Com o template preenchido, entrega a qualquer momento.
# Os parâmetros do corpo vão nesta ordem: {{1}} cliente, {{2}} nº da OS, {{3}} link.
WHATSAPP_OS_TEMPLATE=
WHATSAPP_OS_TEMPLATE_LANG=pt_BR

# `off` desliga o disparo do robô sem apagar as credenciais acima.
WHATSAPP_TRANSPORT=

# Webhook (api/webhooks/whatsapp.php) — é ele que grava as mensagens recebidas
# e abre a janela de 24 horas.
#
# Token que a Meta devolve na verificação da URL. Escolha um valor qualquer e
# repita o mesmo no painel da Meta. Gere com:
#   php -r "echo bin2hex(random_bytes(24));"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App Secret do app da Meta (Configurações > Básico). Sem ele o webhook recusa
# TODO evento: é o que prova que o corpo veio mesmo da Meta, e não de alguém
# inventando mensagem de cliente para abrir a janela de 24h por conta própria.
WHATSAPP_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Ordem de Serviço — link público e e-mail
# ─────────────────────────────────────────────────────────────────────────────
# Raiz absoluta do site, usada para montar o link com token que vai no e-mail e
# no WhatsApp. Em branco, o endereço é deduzido do cabeçalho Host da requisição
# — que o cliente controla. FIXE em produção.
SITE_BASE_URL=https://www.ecolevaeco.com

# Remetente do e-mail da OS. Em branco, usa o mesmo de public/contact.php.
OS_MAIL_FROM=

# `log` desliga o envio de e-mail e só registra o destinatário no log — modo de
# desenvolvimento, onde mail() cairia em um sendmail inexistente. Vazio = envia.
MAIL_TRANSPORT=

# ─────────────────────────────────────────────────────────────────────────────
# Publicação FTP (somente local/CI; nunca prefixar com NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────────
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# A conta FTP limitada já abre dentro de public_html.
FTP_UPLOAD_PATH=.

# Template da fatura: cliente, valor, vencimento e link.
WHATSAPP_BILLING_TEMPLATE=
WHATSAPP_BILLING_TEMPLATE_LANG=pt_BR
