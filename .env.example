# ─────────────────────────────────────────────────────────────────────────────
# Configuração pública (acessível no client) — placeholders para troca rápida
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.ecoleta.com

# Contato exibido no site
NEXT_PUBLIC_CONTACT_EMAIL=contato@ecoleta.com
NEXT_PUBLIC_WHATSAPP_NUMBER=55XXXXXXXXXXX

# Redes sociais
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/XXXXXXXX
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/XXXXXXXX

# Dados institucionais (rodapé)
NEXT_PUBLIC_CNPJ=00.000.000/0000-00
NEXT_PUBLIC_ADDRESS=Endereço a definir

# ─────────────────────────────────────────────────────────────────────────────
# Envio do formulário (server-side, NÃO expor no client)
# ─────────────────────────────────────────────────────────────────────────────

# Destinatário das mensagens do formulário
CONTACT_TO_EMAIL=contato@ecoleta.com
CONTACT_FROM_EMAIL=noreply@ecoleta.com
CONTACT_FROM_NAME=Site Ecoleta

# ─── Opção 1: Resend (recomendado) ───
# Cadastre o domínio em https://resend.com/domains, crie uma API key e cole aqui
RESEND_API_KEY=

# ─── Opção 2: SMTP autenticado (usar em vez do Resend) ───
# Para usar SMTP, instalar nodemailer:
#   npm install nodemailer @types/nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
