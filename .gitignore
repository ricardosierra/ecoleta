# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# pacotes de build
# O site é publicado por FTP a partir de out/, arquivo por arquivo: nunca por zip.
# ecoleta-out.zip chegou a ser versionado por engano e ainda pesa 143 MB no
# histórico, em três blobs. Ver docs/peso-do-repositorio.md.
# Até aqui a proteção vinha do ~/.gitignore_global do dono, que só existe na
# máquina dele: em qualquer outro clone um "git add ." recolocaria o zip.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# saída de ferramentas auxiliares
/graphify-out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated php env
public/api/env.php
out/api/env.php

# trava de instalação única gerada em runtime por public/api/install.php
public/api/.install-lock
out/api/.install-lock

# phpunit.phar baixado por scripts/phpunit.sh e cache do phpunit
/tools
